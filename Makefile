# ⠀⠈⠻⣦⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣶⠚⠋⠙⠓⢶⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⠞⠁⠀
# ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠛⠲⠖⠛⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀

NAME 		= c_light_core_library.a

SRCDIR 		= src
OBJDIR 		= .obj
INCDIR 		= include

SRCS 		= $(addprefix $(SRCDIR)/, \
				vector/get_header.c)

OBJS 		= $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))
DEPS 		= $(OBJS:.o=.d)

CFLAGS 		= -Werror -Wextra -Wall -pedantic -MD -MP -I $(INCDIR) -g3
AR 			= ar -rcs
DEPFLAGS 	= -MMD -MP

$(OBJDIR)/%.o: %.c
			@mkdir -p $(dir $@)
			$(CC) $(CFLAGS) -c $< -o $@

$(NAME): 	$(OBJS)
			$(AR) $(NAME) $(OBJS)

all: 		$(NAME)

clean:
			rm -rf $(OBJDIR)

fclean: 	clean
			rm -f $(NAME)

re: 		fclean
			make all

-include 	$(DEPS)

.PHONY: 	all clean fclean re